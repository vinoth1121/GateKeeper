# GateKeeper local development defaults — copy to .env and adjust as needed.
# The dev admin key matches the compose default (dev-admin-key-change-me).
GATEKEEPER_ADMIN_KEY=dev-admin-key-change-me

# Local (non-Docker) wiring. When running via infra/docker-compose.yml the
# gateway container overrides these with its in-network service addresses.
GATEKEEPER_REDIS_URL=redis://localhost:6379
GATEKEEPER_UPSTREAM_URL=http://localhost:8081

# Comma-separated list of trusted proxy IPs/CIDRs allowed to set X-Forwarded-For.
GATEKEEPER_TRUSTED_PROXIES=

# Smoke-test target (scripts/smoke.sh)
SMOKE_URL=http://localhost:8080

# k6 load scripts (loadtest/*.js)
K6_BASE_URL=http://localhost:8080